# Axiom local development environment variables.
# Copy this file to .env and adjust as needed. .env is excluded from git
# and from the Docker build context (.dockerignore).
# Only disposable local-development credentials go here.
#
# WHERE THIS FILE IS READ
# -----------------------
# The application reads .env from the repository root, no matter which
# directory the process was started from. A .env in the current working
# directory is read as well and takes precedence.
#
# The values below are for a process running ON THE HOST. A process
# running inside Docker gets its configuration from docker-compose.yml
# instead, where the services are reachable as "postgres:5432" and
# "redis:6379". Using the host values inside Docker makes the API
# connect to nothing.
#
# Docker Compose also reads this file when it substitutes variables in
# docker-compose.yml. That is why the Compose file uses AXIOM_ prefixed
# variable names: it must not pick up the localhost URLs below.

# 127.0.0.1 and not "localhost": on Windows "localhost" resolves to ::1
# first, and a port that is published on IPv4 only leaves that first
# attempt hanging until the connect timeout instead of being refused.
DATABASE_URL=postgresql+psycopg://axiom:axiom@127.0.0.1:5432/axiom
REDIS_URL=redis://127.0.0.1:6379/0
ENV=dev

# Signing key for JWT access tokens. Replace with a strong random value
# (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
# before running anywhere other than local development.
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me

# Browser origins allowed to call the API (comma separated).
# The default is the Vite dev server used by the React frontend.
# Do not use "*" with credentials enabled.
CORS_ORIGINS=http://localhost:5173

# Storage backend used for uploaded files. Phase 3 implements "local";
# an unknown value is rejected at startup.
STORAGE_BACKEND=local

# Uploaded files are written under backend/storage/ (relative to this
# directory's parent). Never commit that directory.
STORAGE_ROOT=storage

# Maximum accepted upload size in bytes (25 MiB).
MAX_UPLOAD_BYTES=26214400

# Login rate limiting: failed attempts allowed per account, per source IP,
# and the length of the window in seconds.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# What the login endpoint does when Redis (the rate limiter) is
# unreachable:
#   open   - allow the attempt through and log the outage (default).
#   closed - refuse every login with 503 until Redis is back.
LOGIN_RATE_LIMIT_FAILURE_MODE=open

# Database connection limits, in seconds. They keep an unreachable
# database from turning a request into an indefinite wait.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
