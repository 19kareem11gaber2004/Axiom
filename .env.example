# Axiom local development environment variables.
# Copy this file to .env and adjust as needed. .env is excluded from git
# and from the Docker build context (.dockerignore).
# Only disposable local-development credentials go here.

DATABASE_URL=postgresql+psycopg://axiom:axiom@localhost:5432/axiom
REDIS_URL=redis://localhost:6379/0
ENV=dev

# Signing key for JWT access tokens. Replace with a strong random value
# (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
# before running anywhere other than local development.
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me

# Uploaded files are written under backend/storage/ (relative to this
# directory's parent). Never commit that directory.
STORAGE_ROOT=storage

# Maximum accepted upload size in bytes (25 MiB).
MAX_UPLOAD_BYTES=26214400
